    "cognee:check": "tsx scripts/cognee-check.ts"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "next": "16.3.5",
    "openai": "^4.73.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
