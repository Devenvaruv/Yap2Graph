{
  "name": "yap2graph",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "ingest": "tsx scripts/ingest.ts",
    "ingest:live": "tsx scripts/ingest-live.ts",
