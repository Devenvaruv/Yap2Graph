# Local Ollama models used by the TypeScript pipeline.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:4b-instruct
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest

# Base URL of the uv-managed local Cognee REST service (add / cognify / search).
# Start it with: npm run cognee:serve
COGNEE_API_URL=http://localhost:8010

# Google OAuth credentials for the Gmail connector.
# Create a Web Application OAuth client at https://console.cloud.google.com/apis/credentials
# and enable the Gmail API. Add http://localhost:3000/auth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Optional: a previously-obtained Gmail refresh token for non-interactive runs.
# If omitted, the connector will prompt for interactive OAuth on first use.
GMAIL_REFRESH_TOKEN=

# Postgres connection string for the daily_activities table read by the
# ChatGPT connector (npm run ingest:live).
DATABASE_URL=

# Optional: which day's ChatGPT activity to fetch, as YYYY-MM-DD.
# Defaults to today (UTC) when omitted.
CHATGPT_ACTIVITY_DATE=
